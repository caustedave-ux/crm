.error-box { color: #e5484d; font-size: 26rpx; }
.head-card {
  background: linear-gradient(135deg, #2f6bff, #5b8cff);
  color: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 34rpx 30rpx;
}
.head-company { font-size: 36rpx; font-weight: 700; }
.head-sub { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.head-tags { margin-top: 18rpx; }
.tag-white { background: rgba(255, 255, 255, 0.2); color: #ffffff; margin-top: 8rpx; }
.copyable { color: #2f6bff; }
.notes {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  color: #4a5568;
  font-size: 26rpx;
  line-height: 1.6;
}
.contact-item { padding: 18rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.contact-item:last-child { border-bottom: none; }
.contact-line { display: flex; align-items: center; gap: 12rpx; }
.contact-name { font-weight: 600; font-size: 28rpx; }
.contact-pos { color: #8a94a6; font-size: 24rpx; }
.contact-acts { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.action-link {
  color: #2f6bff;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  background: #eef3ff;
  border-radius: 999rpx;
}
.act-item { padding: 18rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.act-item:last-child { border-bottom: none; }
.act-line { display: flex; align-items: center; justify-content: space-between; }
.act-date { color: #8a94a6; font-size: 22rpx; }
.act-subject { margin-top: 10rpx; font-size: 26rpx; color: #1f2b3d; line-height: 1.5; }
.act-next { margin-top: 8rpx; color: #e8830c; font-size: 24rpx; }
