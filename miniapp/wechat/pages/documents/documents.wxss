.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 43, 61, 0.05);
}
.search-input { flex: 1; font-size: 28rpx; }
.search-btn {
  background: #2f6bff;
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
}
.filter-bar {
  white-space: nowrap;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
}
.filter-chip {
  display: inline-block;
  font-size: 26rpx;
  color: #4a5568;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border: 1rpx solid #eef0f4;
}
.chip-active {
  background: #2f6bff;
  color: #ffffff;
  border-color: #2f6bff;
}
.count-line { color: #8a94a6; font-size: 24rpx; margin: 16rpx 30rpx 0; }
.error-box { color: #e5484d; font-size: 26rpx; }
.doc-card { padding: 24rpx 28rpx; }
.doc-top { display: flex; align-items: center; justify-content: space-between; }
.doc-no { font-size: 30rpx; font-weight: 700; }
.doc-type { color: #2f6bff; font-size: 24rpx; margin-top: 8rpx; }
.doc-company { color: #8a94a6; font-size: 24rpx; margin-top: 6rpx; }
.doc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.doc-amount { font-size: 30rpx; font-weight: 700; color: #12a15c; }
.amount-void { color: #8a94a6; text-decoration: line-through; }
.doc-date { color: #8a94a6; font-size: 24rpx; }
