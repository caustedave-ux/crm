.hello {
  padding: 30rpx 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}
.error-box { color: #e5484d; font-size: 26rpx; }
.error-tip { color: #8a94a6; margin-top: 10rpx; font-size: 24rpx; }

.stat-grid {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
}
.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #2f6bff, #5b8cff);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}
.stat-card + .stat-card {
  background: linear-gradient(135deg, #e8830c, #f5a623);
}
.stat-num { font-size: 52rpx; font-weight: 700; }
.stat-label { font-size: 26rpx; opacity: 0.9; margin-top: 4rpx; }
.stat-sub { font-size: 22rpx; opacity: 0.75; margin-top: 8rpx; }

.quick-grid { display: flex; text-align: center; }
.quick-item { flex: 1; font-size: 24rpx; color: #4a5568; }
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  line-height: 88rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}
.quick-icon.blue { background: #2f6bff; }
.quick-icon.green { background: #12a15c; }
.quick-icon.orange { background: #e8830c; }
.quick-icon.gray { background: #8a94a6; }

.fu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.fu-item:last-child { border-bottom: none; }
.fu-main { flex: 1; margin-right: 16rpx; }
.fu-company { font-weight: 600; font-size: 28rpx; }
.fu-note { color: #8a94a6; font-size: 24rpx; margin-top: 6rpx; }

.doc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.doc-item:last-child { border-bottom: none; }
.doc-no { font-weight: 600; font-size: 28rpx; }
.doc-company { color: #8a94a6; font-size: 24rpx; margin-top: 6rpx; }
.doc-right { text-align: right; }
.doc-amount { font-weight: 600; color: #12a15c; font-size: 28rpx; margin-bottom: 8rpx; }
