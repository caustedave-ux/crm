.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2f6bff 0%, #4f86ff 40%, #f5f7fa 40%);
  padding: 0 48rpx;
}

.brand {
  padding: 90rpx 0 70rpx;
  text-align: center;
  color: #ffffff;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
}

.brand-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 39, 51, 0.1);
}

.login-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2733;
  text-align: center;
  margin-bottom: 40rpx;
}

.wx-login-btn {
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  line-height: 1.4;
}

.wx-login-btn.is-loading {
  background: #8fd8b0;
}

.err-msg {
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #e0483d;
  text-align: center;
}

.browse-link {
  margin-top: 28rpx;
  font-size: 27rpx;
  color: #2f6bff;
  text-align: center;
}

.login-tip {
  margin-top: 36rpx;
  font-size: 23rpx;
  color: #8a94a6;
  text-align: center;
}
