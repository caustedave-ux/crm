<view class="page">
  <view class="search-bar">
    <text class="muted">🔍</text>
    <input
      value="{{kw}}"
      placeholder="搜索单号 / 标题"
      placeholder-class="muted"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
      confirm-type="search"
    />
  </view>

  <view class="filters">
    <view
      wx:for="{{types}}"
      wx:key="key"
      class="filter-chip {{type === item.key ? 'active' : ''}}"
      data-type="{{item.key}}"
      bindtap="onTypeTap"
    >{{item.name}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:if="{{!loading && errMsg}}" class="card">
    <view class="empty">{{errMsg}}</view>
    <view class="btn btn-ghost" bindtap="onSearch">重试</view>
  </view>

  <view wx:if="{{!loading && !errMsg}}" class="card">
    <view class="card-title">
      <text>单据列表</text>
      <text class="more">共 {{total}} 张</text>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">没有匹配的单据</view>

    <view wx:for="{{list}}" wx:key="id" class="doc-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="doc-item-top">
        <view class="t-main">{{item.doc_no}}</view>
        <view class="tag {{item.status === '已作废' ? 'tag-red' : ''}}">{{item.status}}</view>
      </view>
      <view class="doc-item-mid">
        <text class="t-sub">{{item.typeName}}</text>
        <text class="t-sub" wx:if="{{item.company_name}}"> · {{item.company_name}}</text>
      </view>
      <view class="doc-item-bottom">
        <view class="t-strong">{{item.currency}} {{item.amountText}}</view>
        <view class="t-sub">{{item.dateText}}</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading">加载更多…</view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="loading">已全部加载</view>
  </view>
</view>
