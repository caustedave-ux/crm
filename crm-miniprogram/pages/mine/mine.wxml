<view class="page">
  <view class="card user-card">
    <view class="avatar big">{{loggedIn ? '微' : '客'}}</view>
    <view class="user-main">
      <view class="t-main">{{userText}}</view>
      <view class="t-sub" wx:if="{{uidText}}">账号 {{uidText}}</view>
      <view class="t-sub" wx:if="{{!loggedIn}}">登录后可使用新增、编辑与库存调整</view>
    </view>
  </view>

  <view class="card" wx:if="{{!loggedIn}}">
    <view class="btn" bindtap="onLogin">微信一键登录</view>
  </view>

  <view class="card">
    <view class="card-title">常用功能</view>
    <view class="list-item" bindtap="goProducts">
      <view class="t-main">产品库</view>
      <view class="t-sub">›</view>
    </view>
    <view class="list-item" bindtap="goStock">
      <view class="t-main">库存管理</view>
      <view class="t-sub">›</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">关于数据</view>
    <view class="t-sub about">
      客户、跟进、单据、产品数据存储在云端。游客可浏览团队共享数据，登录后可查看自己名下的数据并使用写功能。
    </view>
  </view>

  <view class="btn logout-btn" wx:if="{{loggedIn}}" bindtap="onLogout">退出登录</view>
</view>
