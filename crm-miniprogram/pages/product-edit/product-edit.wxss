.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
}

.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f0f2f5;
}

.img-del {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 30rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #c3cad6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.img-plus {
  font-size: 52rpx;
  color: #8a94a6;
  line-height: 1;
}

.img-add-text {
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 8rpx;
}

.img-tip {
  margin-top: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.field:last-child {
  border-bottom: none;
}

.f-label {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #8a94a6;
}

.field.required .f-label::after {
  content: ' *';
  color: #e0483d;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2733;
  text-align: right;
}

.ph {
  color: #c3cad6;
  font-size: 26rpx;
}

.f-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
  color: #1f2733;
}

.f-picker .arrow {
  color: #c3cad6;
  margin-left: 12rpx;
  font-size: 34rpx;
}

.f-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1f2733;
  min-height: 120rpx;
  margin-top: 16rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bottom-space {
  height: 40rpx;
}
