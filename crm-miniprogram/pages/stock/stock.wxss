.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.stat-cell {
  width: 50%;
  padding: 18rpx 0;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2733;
  line-height: 1.2;
}

.stat-num.sm {
  font-size: 32rpx;
}

.stat-num.red {
  color: #e0483d;
}

.stat-num.orange {
  color: #e08b1f;
}

.stat-label {
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 6rpx;
}

.tip-row {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff8ec;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #b3761a;
  line-height: 1.6;
}

.stock-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.stock-item:last-child {
  border-bottom: none;
}

.si-main {
  flex: 1;
  padding-right: 20rpx;
}

.si-main .t-main {
  display: flex;
  align-items: center;
}

.si-main .tag {
  margin-left: 12rpx;
}

.si-side {
  text-align: right;
  flex-shrink: 0;
}

.si-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2733;
}

.si-num.num-red {
  color: #e0483d;
}

.si-btn {
  margin-top: 10rpx;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: #eef3ff;
  color: #2f6bff;
  font-size: 24rpx;
  display: inline-block;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 40rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2733;
}

.sheet-sub {
  font-size: 25rpx;
  color: #8a94a6;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.f-label {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #8a94a6;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2733;
  text-align: right;
}

.ph {
  color: #c3cad6;
  font-size: 26rpx;
}

.sheet-tip {
  font-size: 24rpx;
  color: #e08b1f;
  margin-top: 16rpx;
}

.bottom-space {
  height: 40rpx;
}
