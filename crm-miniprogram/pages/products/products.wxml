<view class="page">
  <view class="search-bar">
    <text class="muted">🔍</text>
    <input
      value="{{kw}}"
      placeholder="搜索品名 / 型号 / HS编码"
      placeholder-class="muted"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
      confirm-type="search"
    />
  </view>

  <view class="actions">
    <view class="act-btn act-primary" bindtap="onAdd">+ 新增产品</view>
    <view class="act-btn" bindtap="onStock">库存管理</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:if="{{!loading && errMsg}}" class="card">
    <view class="empty">{{errMsg}}</view>
    <view class="btn btn-ghost" bindtap="onSearch">重试</view>
  </view>

  <view wx:if="{{!loading && !errMsg}}" class="card">
    <view class="card-title">
      <text>产品库</text>
      <text class="more">共 {{total}} 个</text>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">没有匹配的产品</view>

    <view wx:for="{{list}}" wx:key="id" class="prod-item" bindtap="onDetail" data-id="{{item.id}}">
      <image wx:if="{{item.coverUrl}}" class="prod-thumb" src="{{item.coverUrl}}" mode="aspectFill" />
      <view wx:else class="prod-thumb prod-thumb-ph">无图</view>
      <view class="prod-main">
        <view class="t-main">{{item.name}}</view>
        <view class="t-sub" wx:if="{{item.name_en}}">{{item.name_en}}</view>
        <view class="t-sub">
          <text wx:if="{{item.model}}">型号 {{item.model}}</text>
          <text wx:if="{{item.hs_code}}"> · HS {{item.hs_code}}</text>
        </view>
      </view>
      <view class="prod-side">
        <view class="t-strong">{{item.currency}} {{item.priceText}}</view>
        <view class="t-sub {{item.stockLow ? 'stock-low' : ''}}">
          库存 {{item.stock}}{{item.unit ? ' ' + item.unit : ''}}
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading">加载更多…</view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="loading">已全部加载</view>
  </view>
</view>
