.cust-head {
  display: flex;
  align-items: center;
}

.avatar.big {
  width: 96rpx;
  height: 96rpx;
  font-size: 38rpx;
  border-radius: 20rpx;
}

.cust-head-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.cust-head-main .name {
  font-size: 34rpx;
  font-weight: 600;
}

.tags {
  display: flex;
  margin-top: 12rpx;
}

.tags .tag {
  margin-right: 12rpx;
}

.copy-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2f6bff;
  border: 1rpx solid #cddcff;
  border-radius: 22rpx;
  padding: 2rpx 16rpx;
  margin-left: 12rpx;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-main {
  flex: 1;
  min-width: 0;
}

.contact-main .tag {
  margin-left: 12rpx;
}

.contact-side {
  flex-shrink: 0;
  text-align: right;
}

.contact-side .copy-btn {
  display: inline-block;
  margin: 0 0 10rpx 12rpx;
}

.act-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.act-item:last-child {
  border-bottom: none;
}

.act-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.content {
  margin-top: 6rpx;
  line-height: 1.6;
}
